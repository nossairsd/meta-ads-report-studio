# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is the documentation for what a
# contributor has to set, so it must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

CLAUDE.md
AGENTS.md

# Prisma generates the client as source into the project (v7 behaviour).
# It is rebuilt by `prisma generate`, so it is a build artefact, not source.
/generated/prisma

# Scratch files served from public/ during debugging (PDF renders, probes).
public/_*

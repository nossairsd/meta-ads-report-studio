# Copy to .env.local and fill in. .env.local is git-ignored.
#
# None of these are needed for the landing page or the /demo route — those run
# with no configuration at all. They are required once the Meta connection and
# the authenticated dashboard are in use.

# PostgreSQL connection string (Neon, Supabase, or a local server).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# From the Meta app dashboard: developers.facebook.com/apps
# Add http://localhost:3000/api/auth/callback/facebook as a valid OAuth
# redirect URI, or sign-in will be rejected before it reaches this app.
META_APP_ID=""
META_APP_SECRET=""

# Only for an app whose dashboard offers "Facebook Login for Business" rather
# than the classic Facebook Login — which is now the default for newly created
# apps. Its authorization dialog takes the id of a saved configuration instead
# of a scope list, so the permissions (ads_read) are chosen once in the app
# dashboard under Facebook Login for Business > Configurations.
# Leave unset for an app with the classic product.
# META_LOGIN_CONFIG_ID=""

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts the Meta access token at rest. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Changing this makes every already-stored token undecryptable, and every
# connected user has to sign in again.
TOKEN_ENCRYPTION_KEY=""

# Who may open /dashboard/admin, where early-access requests are reviewed:
# Meta user ids, comma-separated. Meta ids are specific to each Meta app, so
# the id changes if the app does. Find yours in the Account table
# (providerAccountId) after signing in once. Unset means nobody is admin.
# ADMIN_META_USER_IDS=""

# Optional, and only needed behind a TLS-inspecting corporate proxy (Zscaler,
# Netskope and similar). Such a proxy re-signs every HTTPS response with its
# own root certificate, which Node does not trust: the server-side half of the
# OAuth exchange then fails with SELF_SIGNED_CERT_IN_CHAIN while the browser
# half appears to succeed. Point this at a PEM bundle containing your
# organisation's root certificates. Leave it unset on an ordinary network.
# NODE_EXTRA_CA_CERTS="C:/path/to/corporate-ca-bundle.pem"

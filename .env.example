# Copy to .env.local and fill in. .env.local is git-ignored.
#
# None of these are needed for the landing page or the /demo route — those run
# with no configuration at all. They are required once the Meta connection and
# the authenticated dashboard are in use.

# PostgreSQL connection string (Neon, Supabase, or a local server).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# From the Meta app dashboard: developers.facebook.com/apps
# Add http://localhost:3000/api/auth/callback/facebook as a valid OAuth
# redirect URI, or sign-in will be rejected before it reaches this app.
META_APP_ID=""
META_APP_SECRET=""

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts the Meta access token at rest. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Changing this makes every already-stored token undecryptable, and every
# connected user has to sign in again.
TOKEN_ENCRYPTION_KEY=""
